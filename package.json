{
  "name": "numerologia-codex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mapa numerológico com cálculos e interpretações transcritas do PDF fornecido, sem citações de páginas.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "importar-textos": "node scripts/importar-textos-privados.mjs",
    "gerar-docs": "node scripts/gerar-docs.mjs",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:tudo": "vitest run && playwright test",
    "predev": "npm run importar-textos",
    "prebuild": "npm run importar-textos && node scripts/verificar-textos.mjs",
    "verificar-textos": "node scripts/verificar-textos.mjs",
    "pretest": "npm run importar-textos"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
